{
  "Statement": [
    {
      "Action": "ecr:GetAuthorizationToken",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ECRAuthToken"
    },
    {
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:ecr:us-east-1:000000000000:repository/app",
      "Sid": "ECRPushToOneRepository"
    },
    {
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeTaskDefinition"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ECSTaskDefinitions"
    },
    {
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:ecs:us-east-1:000000000000:service/app-cluster/app-service",
      "Sid": "ECSDeployOneService"
    },
    {
      "Action": "iam:PassRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:iam::000000000000:role/app-task-execution-role",
        "arn:aws:iam::000000000000:role/app-task-role"
      ],
      "Sid": "PassTaskRolesToECSOnly"
    },
    {
      "Action": "s3:ListBucket",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::acme-build-artifacts",
      "Sid": "ListArtifactsBucket"
    },
    {
      "Action": "s3:GetObject",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::acme-build-artifacts/*",
      "Sid": "ReadArtifacts"
    }
  ],
  "Version": "2012-10-17"
}
